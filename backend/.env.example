ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_ID=adr/6
ROBOFLOW_CONFIDENCE_THRESHOLD=0.3
ROBOFLOW_OVERLAP_THRESHOLD=0.5

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b

REQUEST_TIMEOUT_SECONDS=20
ROBOFLOW_TIMEOUT_SECONDS=20
GROQ_TIMEOUT_SECONDS=12
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_AGE_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600

# Optional
# CORS_ORIGINS=http://localhost:5173,https://dento-scan.netlify.app
